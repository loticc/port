#!/bin/bash
# ==============================================================================
# port - SSH 端口修改工具
# 作者: loticc
# 仓库: https://github.com/loticc/port
# 适用: Debian / Ubuntu
# ==============================================================================

set -euo pipefail

# ---------- 颜色 ----------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC}  $*"; }
success() { echo -e "${GREEN}[OK]${NC}    $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC}  $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ---------- 前置检查 ----------
if [ "$(id -u)" -ne 0 ]; then
    error "需要 root 权限，请使用 sudo 运行"
    exit 1
fi

if ! command -v apt &>/dev/null; then
    warn "未检测到 apt，本脚本仅适配 Debian / Ubuntu，继续运行可能失败"
fi

# ---------- 读取当前 SSH 端口 ----------
CURRENT_PORT=$(sshd -T 2>/dev/null | grep -i "^port " | awk '{print $2}' | head -1)
if [ -z "$CURRENT_PORT" ]; then
    CURRENT_PORT=$(grep -E "^Port " /etc/ssh/sshd_config | awk '{print $2}' | head -1)
fi
CURRENT_PORT=${CURRENT_PORT:-22}

info "当前 SSH 端口: ${CURRENT_PORT}"

# ---------- 读取并校验新端口 ----------
read -rp "请输入新的 SSH 端口号 (1-65535): " NEW_PORT

if ! [[ "$NEW_PORT" =~ ^[0-9]+$ ]]; then
    error "端口号必须是数字"
    exit 1
fi

if [ "$NEW_PORT" -lt 1 ] || [ "$NEW_PORT" -gt 65535 ]; then
    error "端口号必须在 1 ~ 65535 之间"
    exit 1
fi

if [ "$NEW_PORT" -eq "$CURRENT_PORT" ]; then
    error "新端口与当前端口相同，无需修改"
    exit 1
fi

if ss -tlnp 2>/dev/null | grep -q ":${NEW_PORT} "; then
    error "端口 ${NEW_PORT} 已被占用，请更换"
    exit 1
fi

# ---------- 二次确认 ----------
echo ""
warn "即将把 SSH 端口从 ${CURRENT_PORT} 修改为 ${NEW_PORT}"
read -rp "确认继续？(y/n): " CONFIRM
if [[ "$CONFIRM" != [yY] && "$CONFIRM" != [yY][eE][sS] ]]; then
    info "已取消操作"
    exit 0
fi

# ---------- 备份配置文件 ----------
BACKUP="/etc/ssh/sshd_config.bak.$(date +%Y%m%d%H%M%S)"
cp /etc/ssh/sshd_config "$BACKUP"
success "配置文件已备份到 ${BACKUP}"

# ---------- 修改配置文件 ----------
CONFIG="/etc/ssh/sshd_config"

if grep -qE "^#?Port " "$CONFIG"; then
    sed -i "s/^#*Port .*/Port ${NEW_PORT}/" "$CONFIG"
else
    sed -i "1i\\Port ${NEW_PORT}" "$CONFIG"
fi

success "配置文件已更新"

# ---------- 语法检查 ----------
if ! sshd -t 2>/dev/null; then
    error "配置语法检查失败，正在恢复备份..."
    cp "$BACKUP" "$CONFIG"
    error "恢复完成，请检查输入或手动修改 ${CONFIG}"
    exit 1
fi

# ---------- 重启 SSH 服务 ----------
if systemctl restart sshd 2>/dev/null || systemctl restart ssh 2>/dev/null; then
    success "SSH 服务已重启"
else
    error "SSH 服务重启失败，请手动执行 systemctl restart sshd"
fi

# ---------- 防火墙提示 ----------
echo ""
info "========== 防火墙放行提示 =========="

if command -v ufw &>/dev/null && ufw status &>/dev/null; then
    warn "检测到 UFW 防火墙已启用，请执行以下命令放行新端口："
    echo -e "  ${YELLOW}ufw allow ${NEW_PORT}/tcp${NC}"
    echo -e "  ${YELLOW}ufw reload${NC}"
elif command -v firewall-cmd &>/dev/null && systemctl is-active firewalld &>/dev/null; then
    warn "检测到 firewalld 防火墙已启用，请执行以下命令放行新端口："
    echo -e "  ${YELLOW}firewall-cmd --zone=public --add-port=${NEW_PORT}/tcp --permanent${NC}"
    echo -e "  ${YELLOW}firewall-cmd --reload${NC}"
else
    warn "未检测到常用防火墙服务，如使用了 iptables 或其他防火墙，请自行放行端口 ${NEW_PORT}"
fi

echo ""
success "SSH 端口已成功修改为 ${NEW_PORT}"
warn "请不要关闭当前终端！先用新端口测试登录，确认能连上再退出。"
warn "如无法登录，请通过 VNC/控制台恢复备份：cp ${BACKUP} ${CONFIG} && systemctl restart sshd"
